{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug-editor",
      "displayName": "Debug + Editor",
      "description": "SandboxEditor.exe — the editor, debuggable. Assets resolve from the source tree.",
      "binaryDir": "${sourceDir}/build/debug-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "OPAAX_EDITOR_SUPPORT": "ON",
        "OPAAX_DEV_BUILD": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (game)",
      "description": "Sandbox.exe — the game, debuggable, no editor. Assets resolve from the source tree.",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "OPAAX_EDITOR_SUPPORT": "OFF",
        "OPAAX_DEV_BUILD": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Sandbox.exe — shipping build. No editor, no debug overhead; assets deploy next to the exe.",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "OPAAX_EDITOR_SUPPORT": "OFF",
        "OPAAX_DEV_BUILD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-editor",
      "configurePreset": "debug-editor",
      "configuration": "Debug"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}
