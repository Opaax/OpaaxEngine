    "problemMatcher": [
        {
            "owner": "opaax-doctest-msvc",
            "severity": "error",
            "pattern": [
                {
                    "regexp": "^(.+?)\((\d+)\):\s+(?:FATAL )?ERROR:\s+(.*)$",
