                    "persistent": true,
                    "focused": true,
                    "unsaved": false
                }
            ]
        }
    },
    {
        "id": "second",
        "command": "entity.create",
        "params": {
            "name": "Second"
        }
    },
    {
        "id": "save",
        "command": "level.save"
    },
    {
        "id": "reopen",
        "command": "level.open",
        "params": {
            "path": "Scratch/Moving.opaaxlevel"
        },
        "expect": {
            "world": "Moving"
        }
    },
    {
        "command": "expect.entity",
        "params": {
            "entity": "First",
            "exists": true
        },
        "id": "saved-as"
    },
    {
        "command": "expect.entity",
        "params": {
            "entity": "Second",
            "exists": true
        },
        "id": "saved-after"
