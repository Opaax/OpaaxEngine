[
    {
        "repeat": [
            {
                "tag": "60",
                "pacing": "60",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 0
            },
            {
                "tag": "144",
                "pacing": "144",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 1
            }
        ],
        "requests": [
            {
                "id": "pace-{tag}",
                "command": "time.pace",
                "params": {
                    "pacing": "{pacing}"
                }
            },
            {
                "id": "play-{tag}",
                "command": "level.play",
                "params": {
                    "path": "Levels/Following.opaaxlevel"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 0.25
                }
            },
            {
                "id": "trace-EditorCameraFollowing-chase-{tag}",
                "command": "camera.trace.start",
                "params": {
                    "name": "EditorCameraFollowing-chase-{tag}",
                    "target": "Runner"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 1.0
                }
            },
            {
                "id": "EditorCameraFollowing-chase-{tag}",
                "command": "camera.trace.stop",
                "params": {
                    "limits": {
                        "targetDrift": 0.5,
                        "motionJitter": "{jitter}",
                        "timeReversals": 0,
                        "stillMoves": 0,
                        "zoomReversals": 0,
                        "cameraSwitches": 0,
                        "stepsSpread": "{spread}",
                        "mostSteps": 8
                    }
                }
            },
            {
                "id": "EditorCameraFollowing-chase-{tag}-path",
                "command": "camera.trace.compare",
                "params": {
                    "reference": "EditorCameraFollowing-chase-{reference}",
                    "trace": "EditorCameraFollowing-chase-{tag}",
                    "limits": {
                        "position": 0.001,
                        "size": 0.001,
                        "rotation": 0.001
                    }
                }
            },
            {
                "id": "priority-ParentCam-{tag}",
                "command": "component.set",
                "params": {
                    "entity": "ParentCam",
                    "type": "Camera",
                    "value": {
                        "Priority": 5
                    }
                }
            },
            {
                "command": "frames.wait",
                "params": {
                    "count": 2
                }
            },
            {
                "id": "trace-EditorCameraFollowing-parent-{tag}",
                "command": "camera.trace.start",
                "params": {
                    "name": "EditorCameraFollowing-parent-{tag}",
                    "target": "Runner"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 1.0
                }
            },
            {
                "id": "EditorCameraFollowing-parent-{tag}",
                "command": "camera.trace.stop",
                "params": {
                    "limits": {
                        "targetDrift": 0.01,
                        "motionJitter": "{jitter}",
                        "timeReversals": 0,
                        "stillMoves": 0,
                        "cameraSwitches": 0,
                        "stepsSpread": "{spread}",
                        "mostSteps": 8
                    }
                }
            },
            {
                "id": "EditorCameraFollowing-parent-{tag}-path",
                "command": "camera.trace.compare",
                "params": {
                    "reference": "EditorCameraFollowing-parent-{reference}",
                    "trace": "EditorCameraFollowing-parent-{tag}",
                    "limits": {
                        "position": 0.001,
                        "size": 0.001,
                        "rotation": 0.001
                    }
                }
            },
            {
                "id": "stop-{tag}",
                "command": "editor.stop",
                "expect": {
                    "mode": "Edit"
                }
            }
        ]
    }
]
