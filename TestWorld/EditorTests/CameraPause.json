                "spread": 1
            },
            {
                "tag": "240",
                "pacing": "240",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 1
            }
        ],
        "requests": [
            {
                "id": "pace-{tag}",
                "command": "time.pace",
                "params": {
                    "pacing": "{pacing}"
                }
            },
            {
                "id": "play-{tag}",
                "command": "level.play",
                "params": {
                    "path": "Levels/Following.opaaxlevel"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 0.25
                }
            },
            {
                "id": "trace-EditorCameraPause-{tag}",
                "command": "camera.trace.start",
                "params": {
                    "name": "EditorCameraPause-{tag}",
                    "target": "Runner"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 0.1
                }
            },
            {
                "id": "pause-{tag}",
                "command": "editor.pause",
                "expect": {
                    "paused": true
                }
            },
            {
                "command": "frames.wait",
                "params": {
                    "count": 30
                }
            },
            {
                "id": "step-{tag}",
                "command": "editor.step",
                "expect": {
                    "paused": true
                }
            },
            {
                "command": "frames.wait",
                "params": {
                    "count": 30
                }
            },
            {
                "id": "resume-{tag}",
                "command": "editor.pause",
                "expect": {
                    "paused": false
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 0.25
                }
            },
            {
                "id": "EditorCameraPause-{tag}",
                "command": "camera.trace.stop",
                "params": {
                    "limits": {
                        "cameraSwitches": 0,
                        "timeReversals": 0,
                        "zoomReversals": 0,
                        "stillMoves": 0
                    }
                }
            },
            {
                "id": "stop-{tag}",
                "command": "editor.stop",
                "expect": {
                    "mode": "Edit"
                }
            }
        ]
    }
