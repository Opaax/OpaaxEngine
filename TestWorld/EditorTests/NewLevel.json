[
    {
        "command": "frames.wait",
        "params": {
            "count": 10
        }
    },
    {
        "id": "new",
        "command": "level.new",
        "params": {
            "path": "Scratch/Fresh.opaaxlevel",
            "map": "Scratch/Fresh.opaaxmap"
        }
    },
    {
        "command": "expect.count",
        "params": {
            "equals": 0
        },
        "id": "starts-empty"
    },
    {
        "id": "hero",
        "command": "entity.create",
        "params": {
            "name": "Hero",
            "components": {
                "Quad": {
                    "Size": {
                        "x": 50.0,
                        "y": 50.0
                    },
                    "Color": {
                        "x": 0.3,
                        "y": 0.8,
                        "z": 0.4,
                        "w": 1.0
                    }
                }
            }
        }
    },
    {
        "id": "second-map",
        "command": "map.new",
        "params": {
            "path": "Scratch/FreshProps.opaaxmap"
        }
    },
    {
        "id": "prop",
        "command": "entity.create",
        "params": {
            "name": "Prop",
            "components": {
                "Quad": {
                    "Size": {
                        "x": 30.0,
                        "y": 30.0
                    },
                    "Color": {
                        "x": 0.8,
                        "y": 0.5,
                        "z": 0.2,
                        "w": 1.0
                    }
                },
                "Transform": {
                    "Position": {
                        "x": 120.0,
                        "y": 0.0
                    }
                }
            }
        }
    },
    {
        "id": "info-unsaved",
        "command": "level.info",
        "expect": {
            "level": "Scratch/Fresh.opaaxlevel",
            "unsaved": true,
            "maps": [
                {
                    "id": "Fresh",
                    "path": "Scratch/Fresh.opaaxmap",
                    "persistent": true,
                    "focused": false,
                    "unsaved": true
                },
                {
                    "id": "FreshProps",
                    "path": "Scratch/FreshProps.opaaxmap",
                    "persistent": false,
                    "focused": true,
                    "unsaved": true
                }
            ]
        }
    },
    {
        "id": "save",
        "command": "level.save"
    },
    {
        "id": "info-saved",
        "command": "level.info",
        "expect": {
            "unsaved": false,
            "maps": [
                {
                    "unsaved": false
                },
                {
                    "unsaved": false
                }
            ]
        }
    },
    {
        "id": "reopen",
        "command": "level.open",
        "params": {
            "path": "Scratch/Fresh.opaaxlevel"
        },
        "expect": {
            "world": "Fresh"
        }
    },
    {
        "command": "expect.entity",
        "params": {
            "entity": "Hero",
            "exists": true
        },
        "id": "hero-saved"
    },
    {
        "command": "expect.entity",
        "params": {
            "entity": "Prop",
            "exists": true
        },
        "id": "prop-saved"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Prop",
            "path": "Transform/Position/x",
            "equals": 120
        },
        "id": "prop-where-placed"
    },
    {
        "id": "late",
        "command": "entity.create",
        "params": {
            "name": "Late"
        }
    },
    {
        "id": "save-map",
        "command": "map.save"
    },
    {
        "id": "reopen-unasked",
        "command": "level.open",
        "params": {
            "path": "Scratch/Fresh.opaaxlevel"
        },
        "expect": {
            "world": "Fresh"
        }
    },
    {
        "command": "expect.entity",
        "params": {
            "entity": "Late",
            "exists": true
        },
        "id": "map-saved"
    },
    {
        "id": "play",
        "command": "editor.play",
        "expect": {
            "mode": "Play",
            "paused": false
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.2
        }
    },
    {
        "command": "expect.entity",
        "params": {
            "entity": "Hero",
            "exists": true
        },
        "id": "plays"
    },
    {
        "id": "info-while-playing",
        "command": "level.info",
        "expectFailure": true
    },
    {
        "id": "screenshot",
        "command": "screenshot",
        "params": {
            "path": "NewLevel.png"
        }
    },
    {
        "id": "stop",
        "command": "editor.stop",
        "expect": {
            "mode": "Edit"
        }
    },
    {
        "id": "level-exists",
        "command": "level.new",
        "params": {
            "path": "Scratch/Fresh.opaaxlevel"
        },
        "expectFailure": true
    },
    {
        "id": "not-a-level",
        "command": "level.new",
        "params": {
            "path": "Scratch/Fresh.txt"
        },
        "expectFailure": true
    },
    {
        "id": "map-exists",
        "command": "map.new",
        "params": {
            "path": "Scratch/FreshProps.opaaxmap"
        },
        "expectFailure": true
    },
    {
        "id": "level-is-an-asset",
        "command": "asset.get",
        "params": {
            "path": "Scratch/Fresh.opaaxlevel"
        },
        "expect": {
            "class": "LevelAsset",
            "open": false,
            "fromSourceFile": true
        }
    },
    {
        "id": "open-level-asset",
        "command": "asset.open",
        "params": {
            "path": "Levels/Hierarchy.opaaxlevel"
        },
        "expect": {
            "class": "LevelAsset",
            "document": true
        }
    },
    {
        "id": "level-asset-opened",
        "command": "level.info",
        "expect": {
            "level": "Levels/Hierarchy.opaaxlevel",
            "unsaved": false
        }
    },
    {
        "command": "world.info",
        "expect": {
            "name": "Hierarchy",
            "mode": "Edit"
        },
        "id": "level-asset-world"
    }
]
