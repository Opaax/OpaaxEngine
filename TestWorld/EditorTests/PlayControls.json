[
    {
        "command": "frames.wait",
        "params": {
            "count": 10
        }
    },
    {
        "id": "open",
        "command": "level.open",
        "params": {
            "path": "Levels/Behaviours.opaaxlevel"
        },
        "expect": {
            "world": "Behaviours"
        }
    },
    {
        "id": "play",
        "command": "editor.play",
        "expect": {
            "mode": "Play",
            "paused": false
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.3
        }
    },
    {
        "id": "pause",
        "command": "editor.pause",
        "expect": {
            "paused": true
        }
    },
    {
        "id": "reset",
        "command": "component.set",
        "params": {
            "entity": "Lifecycle",
            "type": "LifecycleProbe",
            "value": {
                "UpdateCount": 0
            }
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 5
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Lifecycle",
            "path": "LifecycleProbe/UpdateCount",
            "equals": 0
        },
        "id": "paused-holds"
    },
    {
        "id": "step",
        "command": "editor.step",
        "expect": {
            "paused": true
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 5
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Lifecycle",
            "path": "LifecycleProbe/UpdateCount",
            "equals": 1
        },
        "id": "step-runs-one-frame"
    },
    {
        "id": "resume",
        "command": "editor.pause",
        "expect": {
            "paused": false
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.2
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Lifecycle",
            "path": "LifecycleProbe/UpdateCount",
            "greater": 1
        },
        "id": "resumed"
    },
    {
        "id": "open-while-playing",
        "command": "level.open",
        "params": {
            "path": "Levels/Physics.opaaxlevel"
        },
        "expectFailure": true
    },
    {
        "id": "stop",
        "command": "editor.stop",
        "expect": {
            "mode": "Edit"
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Lifecycle",
            "path": "LifecycleProbe/UpdateCount",
            "equals": 0
        },
        "id": "edit-world-untouched"
    }
]
