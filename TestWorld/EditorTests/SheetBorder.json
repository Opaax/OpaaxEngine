[
    {
        "command": "frames.wait",
        "params": {
            "count": 10
        }
    },
    {
        "id": "open-reads-borders",
        "command": "asset.open",
        "params": {
            "path": "UI/SlicedButtons.opaaxasset"
        },
        "expect": {
            "class": "SpriteSheet",
            "unsaved": false,
            "properties": {
                "Frames": [
                    { "Name": "Normal", "Border": { "Left": 112.0, "Right": 112.0, "Bottom": 85.0, "Top": 112.0 } },
                    { "Name": "Hovered", "Border": { "Left": 9.0, "Right": 9.0, "Bottom": 9.0, "Top": 9.0 } },
                    { "Name": "Pressed", "Border": { "Left": 85.0, "Right": 85.0, "Bottom": 85.0, "Top": 85.0 } },
                    { "Name": "Disabled", "Border": { "Left": 0.0, "Right": 0.0, "Bottom": 0.0, "Top": 0.0 } }
                ]
            }
        }
    },
    {
        "id": "set-a-border-too-wide",
        "command": "asset.set",
        "params": {
            "path": "UI/SlicedButtons.opaaxasset",
            "properties": {
                "Frames": [
                    { "Name": "Normal", "Offset": { "x": 0.0, "y": 0.0 }, "Size": { "x": 256.0, "y": 256.0 },
                      "Border": { "Left": 200.0, "Right": 200.0, "Bottom": 85.0, "Top": 112.0 } },
                    { "Name": "Hovered", "Offset": { "x": 256.0, "y": 0.0 }, "Size": { "x": 256.0, "y": 256.0 },
                      "Border": { "Left": 9.0, "Right": 9.0, "Bottom": 9.0, "Top": 9.0 } },
                    { "Name": "Pressed", "Offset": { "x": 0.0, "y": 256.0 }, "Size": { "x": 256.0, "y": 256.0 },
                      "Border": { "Left": 85.0, "Right": 85.0, "Bottom": 85.0, "Top": 85.0 } },
                    { "Name": "Disabled", "Offset": { "x": 256.0, "y": 256.0 }, "Size": { "x": 256.0, "y": 256.0 } }
                ]
            }
        },
        "expect": {
            "unsaved": true,
            "canUndo": true,
            "properties": {
                "Frames": [
                    { "Border": { "Left": 128.0, "Right": 128.0, "Bottom": 85.0, "Top": 112.0 } },
                    { "Border": { "Left": 9.0 } },
                    { "Border": { "Left": 85.0 } },
                    { "Border": { "Left": 0.0 } }
                ]
            }
        }
    },
    {
        "id": "get-sees-the-window",
        "command": "asset.get",
        "params": {
            "path": "UI/SlicedButtons.opaaxasset"
        },
        "expect": {
            "open": true,
            "properties": {
                "Frames": [
                    { "Border": { "Left": 128.0, "Right": 128.0 } },
                    {},
                    {},
                    {}
                ]
            }
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 3
        }
    },
    {
        "id": "screenshot-sheet",
        "command": "screenshot",
        "params": {
            "path": "SheetBorder.png"
        }
    },
    {
        "id": "undo-puts-it-back",
        "command": "asset.undo",
        "params": {
            "path": "UI/SlicedButtons.opaaxasset"
        },
        "expect": {
            "unsaved": false,
            "canRedo": true,
            "properties": {
                "Frames": [
                    { "Border": { "Left": 112.0, "Right": 112.0, "Bottom": 85.0, "Top": 112.0 } },
                    {},
                    {},
                    {}
                ]
            }
        }
    },
    {
        "id": "close",
        "command": "asset.close",
        "params": {
            "path": "UI/SlicedButtons.opaaxasset"
        }
    }
]
