[
    {
        "id": "play",
        "command": "level.play",
        "params": {
            "path": "Levels/Sliced.opaaxlevel"
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.2
        }
    },
    {
        "id": "mounted",
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/bMounted",
            "equals": true
        }
    },
    {
        "id": "every-widget",
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/Widgets",
            "equals": 8
        }
    },
    {
        "id": "wide-image-listed",
        "command": "ui.list",
        "params": {
            "name": "WideImage"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideImage",
                    "type": "UIImage",
                    "visible": true,
                    "width": 280.0,
                    "height": 60.0
                }
            ]
        }
    },
    {
        "id": "square-image-listed",
        "command": "ui.list",
        "params": {
            "name": "SquareImage"
        },
        "expect": {
            "widgets": [
                {
                    "name": "SquareImage",
                    "type": "UIImage",
                    "visible": true
                }
            ]
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 3
        }
    },
    {
        "id": "wide-image-nine-quads",
        "command": "ui.list",
        "params": {
            "name": "WideImage"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideImage",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "wide-button-normal",
        "command": "ui.list",
        "params": {
            "name": "WideButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideButton",
                    "type": "UIButton",
                    "state": "Normal",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "big-button-normal",
        "command": "ui.list",
        "params": {
            "name": "BigButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "BigButton",
                    "state": "Normal",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "wide-disabled-tiled",
        "command": "ui.list",
        "params": {
            "name": "WideDisabled"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideDisabled",
                    "type": "UIButton",
                    "state": "Disabled",
                    "quads": 5
                }
            ]
        }
    },
    {
        "id": "big-disabled-tiled",
        "command": "ui.list",
        "params": {
            "name": "BigDisabled"
        },
        "expect": {
            "widgets": [
                {
                    "name": "BigDisabled",
                    "state": "Disabled",
                    "quads": 15
                }
            ]
        }
    },
    {
        "id": "screenshot-normal",
        "command": "screenshot",
        "params": {
            "path": "SlicedNormal.png"
        }
    },
    {
        "id": "hover-wide",
        "command": "ui.hover",
        "params": {
            "widget": "WideButton"
        }
    },
    {
        "id": "wide-button-hovered",
        "command": "ui.list",
        "params": {
            "name": "WideButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideButton",
                    "state": "Hovered",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "screenshot-hovered",
        "command": "screenshot",
        "params": {
            "path": "SlicedHovered.png"
        }
    },
    {
        "id": "press-wide",
        "command": "input.key",
        "params": {
            "key": "Mouse_Left",
            "action": "press"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "wide-button-pressed",
        "command": "ui.list",
        "params": {
            "name": "WideButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideButton",
                    "state": "Pressed",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "screenshot-pressed",
        "command": "screenshot",
        "params": {
            "path": "SlicedPressed.png"
        }
    },
    {
        "id": "release-wide",
        "command": "input.key",
        "params": {
            "key": "Mouse_Left",
            "action": "release"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "wide-button-hovered-again",
        "command": "ui.list",
        "params": {
            "name": "WideButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideButton",
                    "state": "Hovered"
                }
            ]
        }
    },
    {
        "id": "hover-big",
        "command": "ui.hover",
        "params": {
            "widget": "BigButton"
        }
    },
    {
        "id": "big-button-hovered",
        "command": "ui.list",
        "params": {
            "name": "BigButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "BigButton",
                    "state": "Hovered",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "wide-button-left",
        "command": "ui.list",
        "params": {
            "name": "WideButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "WideButton",
                    "state": "Normal"
                }
            ]
        }
    },
    {
        "id": "press-big",
        "command": "input.key",
        "params": {
            "key": "Mouse_Left",
            "action": "press"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "big-button-pressed",
        "command": "ui.list",
        "params": {
            "name": "BigButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "BigButton",
                    "state": "Pressed",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "screenshot-big-pressed",
        "command": "screenshot",
        "params": {
            "path": "SlicedBigPressed.png"
        }
    },
    {
        "id": "release-big",
        "command": "input.key",
        "params": {
            "key": "Mouse_Left",
            "action": "release"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    }
]
