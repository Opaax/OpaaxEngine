[
    {
        "repeat": [
            {
                "tag": "60",
                "pacing": "60",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 0
            },
            {
                "tag": "144",
                "pacing": "144",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 1
            },
            {
                "tag": "240",
                "pacing": "240",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 1
            },
            {
                "tag": "60jitter",
                "pacing": "60,jitter=0.25,seed=3",
                "rate": 60,
                "reference": "60",
                "jitter": 0.05,
                "spread": 0
            }
        ],
        "requests": [
            {
                "id": "rate-{tag}",
                "command": "config.set",
                "params": {
                    "config": "Engine",
                    "values": {
                        "Time": {
                            "FixedRate": "{rate}"
                        }
                    }
                }
            },
            {
                "id": "pace-{tag}",
                "command": "time.pace",
                "params": {
                    "pacing": "{pacing}"
                }
            },
            {
                "id": "play-{tag}",
                "command": "level.play",
                "params": {
                    "path": "Levels/SmoothFollowing.opaaxlevel"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 0.25
                }
            },
            {
                "id": "trace-CameraSmooth-{tag}",
                "command": "camera.trace.start",
                "params": {
                    "name": "CameraSmooth-{tag}",
                    "target": "Runner"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 1.0
                }
            },
            {
                "id": "CameraSmooth-{tag}",
                "command": "camera.trace.stop",
                "params": {
                    "limits": {
                        "timeReversals": 0,
                        "stillMoves": 0,
                        "zoomReversals": 0,
                        "cameraSwitches": 0,
                        "motionJitter": 1000.0,
                        "mostSteps": 8
                    }
                }
            },
            {
                "id": "CameraSmooth-{tag}-path",
                "command": "camera.trace.compare",
                "params": {
                    "reference": "CameraSmooth-{reference}",
                    "trace": "CameraSmooth-{tag}",
                    "limits": {
                        "position": 0.001,
                        "size": 0.001
                    }
                }
            },
            {
                "id": "rhythm-{tag}",
                "command": "camera.info",
                "expect": {
                    "live": {
                        "name": "ChaseCam",
                        "rhythm": "steps"
                    }
                }
            }
        ]
    }
]
