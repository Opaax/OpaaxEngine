[
    {
        "repeat": [
            {
                "tag": "720",
                "pacing": "720",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 1,
                "path": 0.001,
                "roll": 0.001
            },
            {
                "tag": "60",
                "pacing": "60",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 0,
                "path": 0.001,
                "roll": 0.001
            },
            {
                "tag": "144",
                "pacing": "144",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 1,
                "path": 0.001,
                "roll": 0.001
            },
            {
                "tag": "240",
                "pacing": "240",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 1,
                "path": 0.001,
                "roll": 0.001
            },
            {
                "tag": "60jitter",
                "pacing": "60,jitter=0.25,seed=3",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 0,
                "path": 0.01,
                "roll": 0.002
            }
        ],
        "requests": [
            {
                "id": "rate-{tag}",
                "command": "config.set",
                "params": {
                    "config": "Engine",
                    "values": {
                        "Time": {
                            "FixedRate": "{rate}"
                        }
                    }
                }
            },
            {
                "id": "pace-{tag}",
                "command": "time.pace",
                "params": {
                    "pacing": "{pacing}"
                }
            },
            {
                "id": "play-{tag}",
                "command": "level.play",
                "params": {
                    "path": "Levels/CameraShake.opaaxlevel"
                }
            },
            {
                "id": "trace-CameraShake-{tag}",
                "command": "camera.trace.start",
                "params": {
                    "name": "CameraShake-{tag}",
                    "target": "Runner"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 1.3
                }
            },
            {
                "id": "pause-{tag}",
                "command": "world.pause",
                "params": {
                    "paused": true
                }
            },
            {
                "command": "frames.wait",
                "params": {
                    "count": 20
                }
            },
            {
                "id": "hit-{tag}",
                "command": "expect.value",
                "params": {
                    "entity": "Blast",
                    "path": "ShakeProbe/bPlayed",
                    "equals": true
                }
            },
            {
                "id": "screenshot-{tag}",
                "command": "screenshot",
                "params": {
                    "path": "CameraShake-{tag}.png"
                }
            },
            {
                "id": "resume-{tag}",
                "command": "world.pause",
                "params": {
                    "paused": false
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 1.3
                }
            },
            {
                "id": "CameraShake-{tag}",
                "command": "camera.trace.stop",
                "params": {
                    "limits": {
                        "timeReversals": 0,
                        "stillMoves": 0,
                        "cameraSwitches": 0,
                        "zoomReversals": 0,
                        "mostSteps": 8
                    }
                }
            },
            {
                "id": "CameraShake-{tag}-path",
                "command": "camera.trace.compare",
                "params": {
                    "reference": "CameraShake-{reference}",
                    "trace": "CameraShake-{tag}",
                    "limits": {
                        "position": "{path}",
                        "size": 0.001,
                        "rotation": "{roll}"
                    }
                }
            },
            {
                "id": "trauma-{tag}",
                "command": "expect.value",
                "params": {
                    "entity": "Quake",
                    "path": "ShakeProbe/bHit",
                    "equals": true
                }
            },
            {
                "id": "settled-{tag}",
                "command": "expect.value",
                "params": {
                    "entity": "Quake",
                    "path": "ShakeProbe/TraumaNow",
                    "near": 0,
                    "tolerance": 0.05
                }
            }
        ]
    }
]
