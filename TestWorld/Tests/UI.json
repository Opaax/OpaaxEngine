            "path": "UIProbe/bMounted",
            "equals": true
        },
        "id": "mounted"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/Widgets",
            "equals": 12
        },
        "id": "every-widget"
    },
    {
        "id": "listed",
        "command": "ui.list",
        "params": {
            "name": "ClickButton"
        }
    },
    {
        "id": "click",
        "command": "ui.click",
        "params": {
            "widget": "ClickButton"
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.2
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/Clicks",
            "equals": 1
        },
        "id": "clicked"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/GameClicks",
            "equals": 0
