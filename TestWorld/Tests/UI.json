        "params": {
            "key": "Mouse_Left",
            "action": "tap"
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.2
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/Clicks",
            "equals": 1
        },
        "id": "button-not-clicked"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/GameClicks",
