[
    {
        "id": "play",
        "command": "level.play",
        "params": {
            "path": "Levels/Filtering.opaaxlevel"
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.5
        }
    },
    {
        "id": "default-is-pixel",
        "command": "renderer.info",
        "expect": {
            "textureFilter": "Pixel"
        }
    },
    {
        "id": "nearest",
