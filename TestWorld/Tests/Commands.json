[
    {
        "id": "play",
        "command": "level.play",
        "params": {
            "path": "Levels/Commands.opaaxlevel"
        }
    },
    {
        "id": "registered-in-its-world",
        "command": "commands.has",
        "params": {
            "name": "probe.ping"
        },
        "expect": {
            "has": true
        }
    },
    {
        "id": "world-command-answers",
        "command": "probe.ping",
        "expect": {
            "world": "Commands",
            "pings": 1
        }
    },
    {
        "id": "world-command-keeps-state",
        "command": "probe.ping",
        "expect": {
            "pings": 2
        }
    },
    {
        "id": "no-cheat-yet",
        "command": "probe.cheats",
        "expect": {
            "count": 0
        }
    },
    {
        "id": "cheat",
        "command": "component.set",
        "params": {
            "entity": "Camera",
            "type": "Transform",
            "value": {
                "Position": {
                    "x": 5.0
                }
            }
        }
    },
    {
        "id": "cheat-told-at-once",
        "command": "probe.cheats",
        "expect": {
            "count": 1,
            "last": "component.set"
        }
    },
    {
        "id": "refused-cheat",
        "command": "component.set",
        "params": {
            "entity": "Nobody",
            "type": "Transform",
            "value": {}
        },
        "expectFailure": true
    },
    {
        "id": "plain-command",
        "command": "commands.has",
        "params": {
            "name": "frames.wait"
        }
    },
    {
        "id": "refused-and-plain-are-not-cheats",
        "command": "probe.cheats",
        "expect": {
            "count": 1
        }
    },
    {
        "id": "flag-set",
        "command": "cheats.info",
        "expect": {
            "cheatsRun": true
        }
    },
    {
        "id": "other-level",
        "command": "level.play",
        "params": {
            "path": "Levels/Extensions.opaaxlevel"
        }
    },
    {
        "id": "gone-with-its-world",
        "command": "commands.has",
        "params": {
            "name": "probe.ping"
        },
        "expect": {
            "has": false
        }
    },
    {
        "id": "back",
        "command": "level.play",
        "params": {
            "path": "Levels/Commands.opaaxlevel"
        }
    },
    {
        "id": "new-world-registers-again",
        "command": "probe.ping",
        "expect": {
            "world": "Commands",
            "pings": 1
        }
    },
    {
        "id": "reopened-from-itself",
        "command": "level.play",
        "params": {
            "path": "Levels/Commands.opaaxlevel"
        }
    },
    {
        "id": "newest-world-runs",
        "command": "probe.ping",
        "expect": {
            "pings": 1
        }
    }
]
