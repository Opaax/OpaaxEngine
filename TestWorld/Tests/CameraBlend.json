[
    {
        "repeat": [
            {
                "tag": "720",
                "pacing": "720",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 1
            },
            {
                "tag": "60",
                "pacing": "60",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 0
            },
            {
                "tag": "144",
                "pacing": "144",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 1
            },
            {
                "tag": "240",
                "pacing": "240",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 1
            },
            {
                "tag": "60jitter",
                "pacing": "60,jitter=0.25,seed=3",
                "rate": 60,
                "reference": "720",
                "jitter": 0.05,
                "spread": 0
            }
        ],
        "requests": [
            {
                "id": "rate-{tag}",
                "command": "config.set",
                "params": {
                    "config": "Engine",
                    "values": {
                        "Time": {
                            "FixedRate": "{rate}"
                        }
                    }
                }
            },
            {
                "id": "pace-{tag}",
                "command": "time.pace",
                "params": {
                    "pacing": "{pacing}"
                }
            },
            {
                "id": "play-{tag}",
                "command": "level.play",
                "params": {
                    "path": "Levels/CameraBlend.opaaxlevel"
                }
            },
            {
                "id": "trace-CameraBlend-{tag}",
                "command": "camera.trace.start",
                "params": {
                    "name": "CameraBlend-{tag}",
                    "target": "Runner"
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 0.9
                }
            },
            {
                "id": "pause-{tag}",
                "command": "world.pause",
                "params": {
                    "paused": true
                }
            },
            {
                "command": "frames.wait",
                "params": {
                    "count": 20
                }
            },
            {
                "id": "blending-{tag}",
                "command": "camera.info",
                "expect": {
                    "live": {
                        "name": "WideCam",
                        "blends": 1,
                        "blend": {
                            "from": "ChaseCam"
                        }
                    }
                }
            },
            {
                "id": "resume-{tag}",
                "command": "world.pause",
                "params": {
                    "paused": false
                }
            },
            {
                "command": "world.wait",
                "params": {
                    "seconds": 1.3
                }
            },
            {
                "id": "CameraBlend-{tag}",
                "command": "camera.trace.stop",
                "params": {
                    "limits": {
                        "timeReversals": 0,
                        "stillMoves": 0,
                        "cameraSwitches": 2,
                        "zoomReversals": 0,
                        "switchJump": 3.0,
                        "mostSteps": 8
                    }
                }
            },
            {
                "id": "CameraBlend-{tag}-path",
                "command": "camera.trace.compare",
                "params": {
                    "reference": "CameraBlend-{reference}",
                    "trace": "CameraBlend-{tag}",
                    "limits": {
                        "position": 0.001,
                        "size": 0.001,
                        "rotation": 0.001
                    }
                }
            },
            {
                "id": "settled-{tag}",
                "command": "camera.info",
                "expect": {
                    "live": {
                        "name": "CloseCam",
                        "blends": 0
                    }
                }
            }
        ]
    }
]
