    {
        "id": "epic-lines",
        "command": "expect.value",
        "params": {
            "entity": "Board",
            "path": "LeaderboardProbe/Lines",
            "equals": "1. Ada 1000 | 2. Player 1200"
        }
    },
    {
        "id": "epic-ghost-back",
        "command": "expect.value",
