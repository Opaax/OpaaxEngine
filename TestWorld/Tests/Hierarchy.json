[
    {
        "id": "play",
        "command": "level.play",
        "params": {
            "path": "Levels/Hierarchy.opaaxlevel"
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.6
        }
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Finger",
            "path": "PoseProbe/WorldX",
            "near": -200,
            "tolerance": 0.01
        },
        "id": "chain-x"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Finger",
            "path": "PoseProbe/WorldY",
            "near": 150,
            "tolerance": 0.01
        },
        "id": "chain-y"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Finger",
            "path": "PoseProbe/ParentName",
            "equals": "Hand"
        },
        "id": "parent-name"
    },
    {
        "command": "expect.value",
        "params": {
            "entity": "Finger",
