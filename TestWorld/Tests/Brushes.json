[
    {
        "id": "play",
        "command": "level.play",
        "params": {
            "path": "Levels/Brushes.opaaxlevel"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "mounted",
        "command": "expect.value",
        "params": {
            "entity": "Hud",
            "path": "UIProbe/bMounted",
            "equals": true
        }
    },
    {
        "id": "pop-first-step",
        "command": "ui.list",
        "params": {
            "name": "Pop"
        },
        "expect": {
            "widgets": [
                {
                    "name": "Pop",
                    "brush": "Anims/Pop.opaaxasset#0",
                    "quads": 1
                }
            ]
        }
    },
    {
        "id": "spinner-plays",
        "command": "ui.list",
        "params": {
            "name": "Spinner"
        },
        "expect": {
            "widgets": [
                {
                    "name": "Spinner",
                    "visible": true,
                    "quads": 1
                }
            ]
        }
    },
    {
        "id": "missing-clip-shows-its-frame",
        "command": "ui.list",
        "params": {
            "name": "Fallback"
        },
        "expect": {
            "widgets": [
                {
                    "name": "Fallback",
                    "brush": "/Engine/SpriteSheets/TSS_Default_UnNamed_128.opaaxasset#1",
                    "quads": 1
                }
            ]
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 1.5
        }
    },
    {
        "id": "pop-last-step",
        "command": "ui.list",
        "params": {
            "name": "Pop"
        },
        "expect": {
            "widgets": [
                {
                    "name": "Pop",
                    "brush": "Anims/Pop.opaaxasset#1"
                }
            ]
        }
    },
    {
        "id": "screenshot",
        "command": "screenshot",
        "params": {
            "path": "Brushes.png"
        }
    },
    {
        "id": "styled-button-normal",
        "command": "ui.list",
        "params": {
            "name": "StyledButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "StyledButton",
                    "state": "Normal",
                    "brush": "UI/SlicedButtons.opaaxasset#0",
                    "quads": 9
                }
            ]
        }
    },
    {
        "id": "hover-styled",
        "command": "ui.hover",
        "params": {
            "widget": "StyledButton"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "styled-button-hovered",
        "command": "ui.list",
        "params": {
            "name": "StyledButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "StyledButton",
                    "state": "Hovered"
                }
            ]
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.4
        }
    },
    {
        "id": "screenshot-styled-hovered",
        "command": "screenshot",
        "params": {
            "path": "BrushesStyledHovered.png"
        }
    },
    {
        "id": "icon-follows-normal",
        "command": "ui.list",
        "params": {
            "name": "FollowIcon"
        },
        "expect": {
            "widgets": [
                {
                    "interaction": "Normal",
                    "brush": "/Engine/SpriteSheets/TSS_Default_UnNamed_128.opaaxasset#0",
                    "name": "FollowIcon"
                }
            ]
        }
    },
    {
        "id": "hover-follow",
        "command": "ui.hover",
        "params": {
            "widget": "FollowButton"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "icon-follows-hover",
        "command": "ui.list",
        "params": {
            "name": "FollowIcon"
        },
        "expect": {
            "widgets": [
                {
                    "interaction": "Hovered",
                    "brush": "/Engine/SpriteSheets/TSS_Default_UnNamed_128.opaaxasset#1",
                    "name": "FollowIcon"
                }
            ]
        }
    },
    {
        "id": "label-follows-hover",
        "command": "ui.list",
        "params": {
            "name": "FollowLabel"
        },
        "expect": {
            "widgets": [
                {
                    "interaction": "Hovered",
                    "name": "FollowLabel"
                }
            ]
        }
    },
    {
        "id": "press-follow",
        "command": "input.key",
        "params": {
            "key": "Mouse_Left",
            "action": "press"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "icon-follows-press",
        "command": "ui.list",
        "params": {
            "name": "FollowIcon"
        },
        "expect": {
            "widgets": [
                {
                    "interaction": "Pressed",
                    "brush": "/Engine/SpriteSheets/TSS_Default_UnNamed_128.opaaxasset#2",
                    "name": "FollowIcon"
                }
            ]
        }
    },
    {
        "id": "label-follows-press",
        "command": "ui.list",
        "params": {
            "name": "FollowLabel"
        },
        "expect": {
            "widgets": [
                {
                    "interaction": "Pressed",
                    "name": "FollowLabel"
                }
            ]
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 0.3
        }
    },
    {
        "id": "screenshot-follow-pressed",
        "command": "screenshot",
        "params": {
            "path": "BrushesFollowPressed.png"
        }
    },
    {
        "id": "release-follow",
        "command": "input.key",
        "params": {
            "key": "Mouse_Left",
            "action": "release"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "sounds-hover-then-click",
        "command": "ui.list",
        "params": {
            "name": "FollowButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "FollowButton",
                    "modifiers": [
                        {
                            "name": "Pulse"
                        },
                        {
                            "name": "Sounds",
                            "lastSound": "Audio/Beep.wav",
                            "sounds": 2
                        }
                    ]
                }
            ]
        }
    },
    {
        "id": "pulse-plays-while-hovered",
        "command": "ui.list",
        "params": {
            "name": "FollowButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "FollowButton",
                    "interaction": "Hovered",
                    "modifiers": [
                        {
                            "name": "Pulse",
                            "playing": true
                        },
                        {
                            "name": "Sounds"
                        }
                    ]
                }
            ]
        }
    },
    {
        "id": "leave-follow",
        "command": "ui.hover",
        "params": {
            "widget": "SpinnerLabel"
        }
    },
    {
        "command": "frames.wait",
        "params": {
            "count": 2
        }
    },
    {
        "id": "pulse-finishes-its-cycle",
        "command": "ui.list",
        "params": {
            "name": "FollowButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "FollowButton",
                    "interaction": "Normal",
                    "modifiers": [
                        {
                            "name": "Pulse",
                            "playing": true
                        },
                        {
                            "name": "Sounds"
                        }
                    ]
                }
            ]
        }
    },
    {
        "command": "world.wait",
        "params": {
            "seconds": 1.2
        }
    },
    {
        "id": "pulse-at-rest",
        "command": "ui.list",
        "params": {
            "name": "FollowButton"
        },
        "expect": {
            "widgets": [
                {
                    "name": "FollowButton",
                    "scale": {
                        "x": 1.0,
                        "y": 1.0
                    },
                    "modifiers": [
                        {
                            "name": "Pulse",
                            "playing": false
                        },
                        {
                            "name": "Sounds"
                        }
                    ]
                }
            ]
        }
    }
]
